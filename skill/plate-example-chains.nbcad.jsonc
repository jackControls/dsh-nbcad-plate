    },
    {
      "id": "blind",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "top_5",
            "pointer": "/id"
          },
          "position": {
            "x": 0,
            "y": 0
          },
          "position_reference": {
            "sketch_name": "Chains",
            "entity_id": {
              "$ref": "blind_y",
              "pointer": "/entity_id"
            },
            "kind": "end"
          },
          "diameter": 5,
          "extent": {
            "type": "distance",
            "depth": 5
          },
          "style": "simple",
          "counterbore_diameter": 0,
          "counterbore_depth": 0,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "body_id": {
        "$ref": "plate_body",
        "pointer": "/id"
      },
      "duration_ms": 350
    }
  ],
  "checks": [
    {
      "id": "final_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "assert": {
        "$ref": "final_scene",
        "pointer": "/errors"
      },
      "equals": []
    },
    {
      "assert": {
        "$count": {
          "$ref": "final_scene",
          "pointer": "/bodies"
        }
      },
      "equals": 1
    }
  ]
}
