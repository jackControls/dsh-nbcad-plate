              },
              "position_reference": {
                "sketch_name": "Chains",
                "entity_id": {
                  "$ref": "small_y",
                  "pointer": "/entity_id"
                },
                "kind": "end"
              }
            },
            {
              "position": {
                "x": 0,
                "y": 0
              },
              "position_reference": {
                "sketch_name": "Chains",
                "entity_id": {
                  "$ref": "small_pitch",
                  "pointer": "/entity_id"
                },
                "kind": "end"
              }
            }
          ]
        }
      }
    },
    {
      "let": {
        "top_4": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "small_cbores"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
