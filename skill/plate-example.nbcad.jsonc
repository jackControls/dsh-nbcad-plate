// Example flow for a flat plate part: located outline, one extrusion, a notch cut, a slot,
// counterbored holes from the top and the bottom face, a bore with a tapped bolt circle,
// a blind hole and a tapped hole drilled into an edge. Millimetres. Origin: lower-left corner
// of the plan view, y up, z = thickness.
{
  "version": 1,
  "name": "Example plate with every idiom",
  "starting_state": "empty",
  "steps": [
    {
      "chapter": "Stock plate",
      "note": "Plate 160 x 50 x 8 mm. Origin at the lower-left corner of the plan view, y up, thickness along +z, so every position is read straight off the print's chains.",
      "duration_ms": 800
    },
    {
      "id": "plate_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Plate outline",
          "plane": {
            "type": "origin_plane",
            "plane": "xy"
          }
        }
      }
    },
    {
      "id": "plate_rectangle",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {
            "x": 0,
            "y": 0
          },
          "corner_hint": {
            "x": 160,
            "y": 50
          },
          "width_mm": 160,
          "height_mm": 50,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "plate_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "plate_rectangle",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point",
                "/position/x": 0,
                "/position/y": 0
              },
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "plate_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "plate_build",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Plate outline",
          "profile_indices": [
            0
          ],
          "operation": "new_body",
          "extent": {
            "type": "distance",
            "distance": 8
          },
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "plate_feature": {
          "$select": {
            "from": {
              "$ref": "plate_build"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "let": {
        "plate_body": {
          "$select": {
            "from": {
              "$ref": "plate_build"
            },
            "path": "/scene/bodies",
            "where": {
              "/feature_id": {
                "$ref": "plate_feature"
              }
            },
            "take": "one"
          }
        }
      }
    },
    {
      "chapter": "Notch in the outline",
      "note": "A notch or step is a second sketch on the same origin plane, cut through all; its rectangle may overhang the edge.",
      "duration_ms": 800
    },
    {
      "id": "notch_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Notch",
          "plane": {
            "type": "origin_plane",
            "plane": "xy"
          }
        }
      }
    },
    {
      "id": "notch_rectangle",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {
            "x": 60,
            "y": 40
          },
          "corner_hint": {
            "x": 100,
            "y": 55
          },
          "width_mm": 40,
          "height_mm": 15,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "notch_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "notch_rectangle",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point",
                "/position/x": 60,
                "/position/y": 40
              },
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "notch_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "notch_cut",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Notch",
          "profile_indices": [
            0
          ],
          "operation": "cut",
          "extent": {
            "type": "through_all"
          },
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": [
            {
              "$ref": "plate_body",
              "pointer": "/id"
            }
          ]
        }
      }
    },
    {
      "chapter": "Slot",
      "note": "A slot is sketch_add_slot center_to_center between the two arc centres with the slot width, then the same cut.",
      "duration_ms": 800
    },
    {
      "id": "slot_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Slot",
          "plane": {
            "type": "origin_plane",
            "plane": "xy"
          }
        }
      }
    },
    {
      "id": "slot_shape",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_slot",
        "arguments": {
          "mode": "center_to_center",
          "p1": {
            "x": 115,
            "y": 14
          },
          "p2": {
            "x": 115,
            "y": 36
          },
          "cursor": {
            "x": 118,
            "y": 25
          },
          "width_mm": 6
        }
      }
    },
    {
      "id": "slot_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "slot_cut",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Slot",
          "profile_indices": [
            0
          ],
          "operation": "cut",
          "extent": {
            "type": "through_all"
          },
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": [
            {
              "$ref": "plate_body",
              "pointer": "/id"
            }
          ]
        }
      }
    },
    {
      "chapter": "Holes from the top face",
      "note": "Bind the current top face (normal +z and plane origin z = thickness) before each hole step; project the design point (x, y, T) into its basis. One call per callout group with positions.",
      "duration_ms": 800
    },
    {
      "let": {
        "top_0": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "slot_cut"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": 1,
              "/plane/origin/2": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "corner_cbores",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "top_0",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                12,
                12,
                8
              ],
              "basis": {
                "$ref": "top_0",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 6.6,
          "extent": {
            "type": "through_all"
          },
          "style": "counterbore",
          "counterbore_diameter": 11,
          "counterbore_depth": 6.5,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false,
          "positions": [
            {
              "position": {
                "$project": {
                  "point": [
                    12,
                    12,
                    8
                  ],
                  "basis": {
                    "$ref": "top_0",
                    "pointer": "/plane"
                  }
                }
              }
            },
            {
              "position": {
                "$project": {
                  "point": [
                    148,
                    12,
                    8
                  ],
                  "basis": {
                    "$ref": "top_0",
                    "pointer": "/plane"
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "let": {
        "top_1": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "corner_cbores"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": 1,
              "/plane/origin/2": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "small_cbores",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "top_1",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                60,
                25,
                8
              ],
              "basis": {
                "$ref": "top_1",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 4.5,
          "extent": {
            "type": "through_all"
          },
          "style": "counterbore",
          "counterbore_diameter": 8,
          "counterbore_depth": 4.6,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false,
          "positions": [
            {
              "position": {
                "$project": {
                  "point": [
                    60,
                    25,
                    8
                  ],
                  "basis": {
                    "$ref": "top_1",
                    "pointer": "/plane"
                  }
                }
              }
            },
            {
              "position": {
                "$project": {
                  "point": [
                    100,
                    25,
                    8
                  ],
                  "basis": {
                    "$ref": "top_1",
                    "pointer": "/plane"
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "let": {
        "top_2": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "small_cbores"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": 1,
              "/plane/origin/2": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "bore",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "top_2",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                40.0,
                25.0,
                8
              ],
              "basis": {
                "$ref": "top_2",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 20,
          "extent": {
            "type": "through_all"
          },
          "style": "simple",
          "counterbore_diameter": 0,
          "counterbore_depth": 0,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false
        }
      }
    },
    {
      "chapter": "Bolt circle",
      "note": "Four M4 on a 32 mm circle around the bore at 45, 135, 225 and 315 degrees: x = cx + 16 cos(a), y = cy + 16 sin(a).",
      "duration_ms": 800
    },
    {
      "let": {
        "top_3": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "bore"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": 1,
              "/plane/origin/2": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "bolt_circle_m4",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "top_3",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                51.3137,
                36.3137,
                8
              ],
              "basis": {
                "$ref": "top_3",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 3.3,
          "extent": {
            "type": "distance",
            "depth": 9
          },
          "style": "simple",
          "counterbore_diameter": 0,
          "counterbore_depth": 0,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false,
          "positions": [
            {
              "position": {
                "$project": {
                  "point": [
                    51.3137,
                    36.3137,
                    8
                  ],
                  "basis": {
                    "$ref": "top_3",
                    "pointer": "/plane"
                  }
                }
              }
            },
            {
              "position": {
                "$project": {
                  "point": [
                    28.6863,
                    36.3137,
                    8
                  ],
                  "basis": {
                    "$ref": "top_3",
                    "pointer": "/plane"
                  }
                }
              }
            },
            {
              "position": {
                "$project": {
                  "point": [
                    28.6863,
                    13.6863,
                    8
                  ],
                  "basis": {
                    "$ref": "top_3",
                    "pointer": "/plane"
                  }
                }
              }
            },
            {
              "position": {
                "$project": {
                  "point": [
                    51.3137,
                    13.6863,
                    8
                  ],
                  "basis": {
                    "$ref": "top_3",
                    "pointer": "/plane"
                  }
                }
              }
            }
          ],
          "thread": {
            "standard": "iso_metric",
            "series": "metric_coarse",
            "designation": "M4",
            "class": "6H",
            "nominal_diameter": 4,
            "pitch": 0.7,
            "threads_per_inch": null,
            "hand": "right",
            "depth": 6,
            "representation": "simplified"
          }
        }
      }
    },
    {
      "chapter": "Holes from the bottom face",
      "note": "A counterbore called out 背面 starts from the bottom face (normal -z, origin z = 0); project the point with z = 0.",
      "duration_ms": 800
    },
    {
      "let": {
        "bottom_0": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "bolt_circle_m4"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": -1,
              "/plane/origin/2": 0
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "back_cbore",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "bottom_0",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                130,
                38,
                0
              ],
              "basis": {
                "$ref": "bottom_0",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 6.6,
          "extent": {
            "type": "through_all"
          },
          "style": "counterbore",
          "counterbore_diameter": 11,
          "counterbore_depth": 4,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false
        }
      }
    },
    {
      "chapter": "Blind hole",
      "note": "A blind hole uses extent distance with the drilled depth.",
      "duration_ms": 800
    },
    {
      "let": {
        "top_4": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "back_cbore"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": 1,
              "/plane/origin/2": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "blind",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "top_4",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                75,
                12,
                8
              ],
              "basis": {
                "$ref": "top_4",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 5,
          "extent": {
            "type": "distance",
            "depth": 5
          },
          "style": "simple",
          "counterbore_diameter": 0,
          "counterbore_depth": 0,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false
        }
      }
    },
    {
      "chapter": "Hole drilled into an edge",
      "note": "Bind the edge face by its normal (y = 0 edge here) and project a point on that face at mid-thickness: [x, 0, T/2]. The drill goes into the material by default.",
      "duration_ms": 800
    },
    {
      "let": {
        "edge_y0": {
          "$select": {
            "from": {
              "$select": {
                "from": {
                  "$ref": "blind"
                },
                "path": "/scene/bodies",
                "where": {
                  "/id": {
                    "$ref": "plate_body",
                    "pointer": "/id"
                  }
                },
                "take": "one"
              }
            },
            "path": "/faces",
            "where": {
              "/plane/normal/1": -1
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "edge_m6",
      "call": {
        "group": "solid/refine",
        "operation": "solid_hole",
        "arguments": {
          "body_id": {
            "$ref": "plate_body",
            "pointer": "/id"
          },
          "face_id": {
            "$ref": "edge_y0",
            "pointer": "/id"
          },
          "position": {
            "$project": {
              "point": [
                20,
                0,
                4.0
              ],
              "basis": {
                "$ref": "edge_y0",
                "pointer": "/plane"
              }
            }
          },
          "diameter": 5,
          "extent": {
            "type": "distance",
            "depth": 13
          },
          "style": "simple",
          "counterbore_diameter": 0,
          "counterbore_depth": 0,
          "countersink_diameter": 0,
          "countersink_angle_deg": 90,
          "flip": false,
          "thread": {
            "standard": "iso_metric",
            "series": "metric_coarse",
            "designation": "M6",
            "class": "6H",
            "nominal_diameter": 6,
            "pitch": 1.0,
            "threads_per_inch": null,
            "hand": "right",
            "depth": 10,
            "representation": "simplified"
          }
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "body_id": {
        "$ref": "plate_body",
        "pointer": "/id"
      },
      "duration_ms": 350
    }
  ],
  "checks": [
    {
      "id": "final_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "assert": {
        "$ref": "final_scene",
        "pointer": "/errors"
      },
      "equals": []
    },
    {
      "assert": {
        "$count": {
          "$ref": "final_scene",
          "pointer": "/bodies"
        }
      },
      "equals": 1
    }
  ]
}
